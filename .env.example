# ── Database (Turso / LibSQL) ────────────────────────────────────────
# Leave blank to use local SQLite (/app/data/urls.db inside the container)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Cache & Analytics (Upstash Redis REST API) ──────────────────────
# Optional: Leave blank to run without Redis caching
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── URLs & Networking ────────────────────────────────────────────────
# Backend URL from browser perspective
BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Security & Cron ──────────────────────────────────────────────────
CRON_SECRET=
