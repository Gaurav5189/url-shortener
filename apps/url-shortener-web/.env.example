# Upstash Redis connection for Edge Middleware (Caching & Analytics)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CRON ───────────────────────────────────────────────────
CRON_SECRET=