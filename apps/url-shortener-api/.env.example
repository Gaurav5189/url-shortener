# ── Turso / LibSQL ────────────────────────────────────────────────
# Get these from: turso db show --url <db-name>  /  turso db tokens create <db-name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Upstash Redis (REST API) ──────────────────────────────────────
# Get these from: https://console.upstash.com → Redis → REST API section
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Application ───────────────────────────────────────────────────
BASE_URL=http://localhost:8000

# ── CRON ───────────────────────────────────────────────────
CRON_SECRET=

# ── Rate limitings ───────────────────────────────────────────────────
# RATE_LIMIT_PER_MINUTE=1 
# RATE_LIMIT_PER_5HR=10
# TRUST_PROXY=True          # Set to True on Azure/Vercel(backend) to trust X-Forwarded-For
# (see all other default env in apps/url-shortener-api/src/url_shortener_api/core/config.py)
