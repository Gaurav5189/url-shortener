# ── Turso / LibSQL ────────────────────────────────────────────────
# Get these from: turso db show --url <db-name>  /  turso db tokens create <db-name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Upstash Redis (REST API) ──────────────────────────────────────
# Get these from: https://console.upstash.com → Redis → REST API section
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Application ───────────────────────────────────────────────────
BASE_URL=http://localhost:8000
